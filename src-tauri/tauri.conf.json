{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OnlyHumans",
  "version": "1.0.13",
  "identifier": "space.deepflux.onlyhumans",
  "mainBinaryName": "OnlyHumans",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5199",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OnlyHumans",
        "width": 760,
        "height": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "DeepFlux",
    "copyright": "(c) 2026 DeepFlux",
    "targets": [
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./nsis-hooks.nsh"
      }
    }
  }
}
